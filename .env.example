# cp .env.example .env 후 값 채우기. .env 는 커밋하지 마세요.
# GitHub Actions (PROD_ENV): 아래는 로컬용. Actions 는 Environment secrets/variables 사용.

# ── GitLab ─────────────────────────────────────────────────────
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com
# label watch (watch-promotion.py / Actions Variables)
AI_REVIEW_GITLAB_PROJECT=group/subgroup/project
# 로컬 단일 MR 리뷰
AI_REVIEW_MR_URL=https://gitlab.example.com/group/project/-/merge_requests/123

# ── promotion watch (로컬만; Actions 는 워크플로 스케줄) ───────
# AI_REVIEW_WATCH_LABEL=promotion
# AI_REVIEW_WATCH_STATE=outputs/watch-state.json
# AI_REVIEW_SLACK_WEBHOOK_URL=

# ── 로컬 출력 경로 ─────────────────────────────────────────────
AI_REVIEW_DIFF=outputs/mr.diff
AI_REVIEW_OUTPUT=outputs/review.md
AI_REVIEW_INLINE_JSON=outputs/inline-candidates.json
AI_REVIEW_RAW_OUTPUT=outputs/review.raw.md
AI_REVIEW_CONTEXT_OUT=outputs/context
AI_REVIEW_GITLAB_PLAN=outputs/gitlab-publication-plan.json

# ── AI CLI (로컬 run-review / run-sliced-review) ───────────────
AI_REVIEW_COMMAND="claude -p --output-format text --max-turns 3 --model opus"

# ── 리뷰 정책 ─────────────────────────────────────────────────
AI_REVIEW_POLICY=policies/blockchain-defi.md
# AI_REVIEW_POLICY=policies/generic-engineering.md
AI_REVIEW_MR_CONTEXT=policies/mr-context.md
AI_REVIEW_MAX_DIFF_LINES=15000
AI_REVIEW_PER_FILE_DIFF_LINES=11000
AI_REVIEW_DRY_RUN=0

# ── GitLab 게시 (로컬) ───────────────────────────────────────
AI_REVIEW_GITLAB_APPLY=0
AI_REVIEW_GITLAB_PUBLISH_INLINE=0
# AI_REVIEW_GITLAB_SUMMARY=auto

# ── 큰 MR 슬라이스 (선택) ─────────────────────────────────────
# AI_REVIEW_SLICES=slices/example.json
# AI_REVIEW_PARTS_DIR=outputs/parts
