# .env.example 을 복사해 .env 를 만든 뒤 값을 채웁니다. .env 는 커밋하지 마세요.

# GitLab
GITLAB_TOKEN=
AI_REVIEW_MR_URL=https://gitlab.example.com/group/project/-/merge_requests/123

# 로컬 경로
AI_REVIEW_DIFF=outputs/mr.diff
AI_REVIEW_OUTPUT=outputs/review.md
AI_REVIEW_INLINE_JSON=outputs/inline-candidates.json
AI_REVIEW_RAW_OUTPUT=outputs/review.raw.md
AI_REVIEW_CONTEXT_OUT=outputs/context
AI_REVIEW_GITLAB_PLAN=outputs/gitlab-publication-plan.json

# Step 4 (AI 리뷰)에 필수. stdin 으로 프롬프트를 읽고 stdout 으로 리뷰를 출력해야 합니다.
# run-review.sh 가 아니라, 러너가 호출하는 승인된 AI CLI 입니다.
# Claude Code 예: AI_REVIEW_COMMAND="claude -p --output-format text --max-turns 3 --model opus"
# Step 4 전에 AI CLI 로그인 필요 (Claude Code: claude 실행 후 /login)
AI_REVIEW_COMMAND=

# 리뷰 러너
AI_REVIEW_MODEL=enterprise-approved-model
AI_REVIEW_SEVERITY_THRESHOLD=medium
AI_REVIEW_OUTPUT_FORMAT=rich
AI_REVIEW_POLICY=policies/generic-engineering.md
# AI_REVIEW_POLICY=policies/blockchain-defi.md
# Optional per-MR notes appended after the policy on every slice
# AI_REVIEW_MR_CONTEXT=policies/mr-context.md
AI_REVIEW_MAX_DIFF_LINES=2000
AI_REVIEW_PER_FILE_DIFF_LINES=300
AI_REVIEW_DRY_RUN=0

# 선택 MR 메타 (설정 시 생성 프롬프트에 포함)
AI_REVIEW_REPOSITORY=
AI_REVIEW_TICKET=
AI_REVIEW_SOURCE_BRANCH=
AI_REVIEW_TARGET_BRANCH=
AI_REVIEW_COMMIT_SHA=
AI_REVIEW_CHANGED_AREA=
AI_REVIEW_BUSINESS_FLOW=

# GitLab 게시 (1 이면 명령줄에 플래그 없이 스크립트만으로 게시)
AI_REVIEW_GITLAB_APPLY=0
AI_REVIEW_GITLAB_PUBLISH_INLINE=0
# GitLab 요약 길이: auto(인라인 있으면 finding 본문 생략), compact, full
AI_REVIEW_GITLAB_SUMMARY=auto

# 큰 MR: 도메인/모듈 슬라이스. run-sliced-review.sh 가 사용합니다.
# AI_REVIEW_SLICES=slices/example.json
# AI_REVIEW_PARTS_DIR=outputs/parts
# AI_REVIEW_ONLY_SLICES=
# AI_REVIEW_RERUN=0
# AI_REVIEW_INCLUDE_PATHS=
# AI_REVIEW_EXCLUDE_PATHS=
