{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Review Inline Candidates",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "severity", "file", "line", "line_type", "body", "confidence"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[CHMLI][0-9]+$"
      },
      "severity": {
        "type": "string",
        "enum": ["critical", "high", "medium", "low", "info"]
      },
      "file": {
        "type": "string",
        "minLength": 1
      },
      "line": {
        "type": "integer",
        "minimum": 1
      },
      "line_type": {
        "type": "string",
        "enum": ["new", "old"]
      },
      "body": {
        "type": "string",
        "minLength": 1
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "additionalProperties": true
  }
}
